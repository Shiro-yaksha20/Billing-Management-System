            price = Decimal(row['price'])
            if price < 0:
                return False, f"Row {row_num}: Price cannot be negative"
        except (InvalidOperation, ValueError):
            return False, f"Row {row_num}: Invalid price format"
    
    return True, ""

# Use in import function:
valid, error = validate_csv_row(row, row_num)
if not valid:
    results['errors'].append(error)
    results['skipped'] += 1
    continue
```

