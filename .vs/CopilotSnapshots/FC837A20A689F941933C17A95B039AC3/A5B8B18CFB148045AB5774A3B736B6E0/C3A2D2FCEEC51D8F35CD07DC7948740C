"""
CSV Service Import Utility

Imports services from CSV file with columns:
- category
- service_name
- variant
- display_name
- price
- notes

Usage:
    from app.csv_service_importer import import_services_from_csv
    import_services_from_csv('path/to/services.csv')
"""

import csv
from decimal import Decimal, InvalidOperation
from pathlib import Path
from typing import Optional

from .database import db_session
from .models import Service
from .utils import logger


def import_services_from_csv(
    csv_file_path: str,
    clear_existing: bool = False,
    deactivate_existing: bool = False
) -> dict:
    """
    Import services from CSV file.
    
    Args:
        csv_file_path: Path to CSV file
        clear_existing: If True, deletes all existing services (DANGEROUS!)
        deactivate_existing: If True, marks all existing services as inactive before import
    
    Returns:
        Dictionary with import statistics:
        {
            'success': True/False,
            'imported': count,
            'skipped': count,
            'errors': [list of error messages],
            'cleared': count (if clear_existing=True),
            'deactivated': count (if deactivate_existing=True)
        }
    """
    results = {
        'success': False,
        'imported': 0,
        'skipped': 0,
        'updated': 0,
        'errors': [],
        'cleared': 0,
        'deactivated': 0
    }
    
    # Validate file exists
    if not Path(csv_file_path).exists():
        results['errors'].append(f"File not found: {csv_file_path}")
        return results
    
    try:
        with db_session() as db:
            # Handle clear_existing flag
            if clear_existing:
                count = db.query(Service).delete()
                results['cleared'] = count
                logger.warning(f"Cleared {count} existing services from database.")
            
            # Handle deactivate_existing flag
            if deactivate_existing and not clear_existing:
                count = db.query(Service).update({'active': False})
                results['deactivated'] = count
                logger.info(f"Deactivated {count} existing services.")
            
            # Read CSV file
            with open(csv_file_path, 'r', encoding='utf-8') as f:
                reader = csv.DictReader(f)
                
                # Validate required columns
                required_cols = {'category', 'service_name', 'display_name', 'price'}
                if not required_cols.issubset(reader.fieldnames or []):
                    missing = required_cols - set(reader.fieldnames or [])
                    results['errors'].append(f"Missing required columns: {missing}")
                    return results
                
                for row_num, row in enumerate(reader, start=2):  # Start at 2 (after header)
                    try:
                        # Parse price
                        try:
                            price = Decimal(row['price']) if row['price'] else None
                        except (InvalidOperation, ValueError):
                            results['errors'].append(
                                f"Row {row_num}: Invalid price '{row['price']}'"
                            )
                            results['skipped'] += 1
                            continue
                        
                        # Check if service already exists (by display_name)
                        existing = db.query(Service).filter(
                            Service.display_name == row['display_name']
                        ).first()
                        
                        if existing:
                            # Update existing service
                            existing.category = row['category']
                            existing.name = row['service_name']
                            existing.variant = row.get('variant') or None
                            existing.display_name = row['display_name']
                            existing.price = price
                            existing.notes = row.get('notes') or None
                            existing.active = True  # Reactivate if was inactive
                            results['updated'] += 1
                            logger.info(f"Updated service: {row['display_name']}")
                        else:
                            # Create new service
                            service = Service(
                                category=row['category'],
                                name=row['service_name'],
                                variant=row.get('variant') or None,
                                display_name=row['display_name'],
                                price=price,
                                notes=row.get('notes') or None,
                                active=True
                            )
                            db.add(service)
                            results['imported'] += 1
                            logger.info(f"Imported service: {row['display_name']}")
                    
                    except Exception as e:
                        results['errors'].append(f"Row {row_num}: {str(e)}")
                        results['skipped'] += 1
                        logger.error(f"Error importing row {row_num}: {e}")
        
        results['success'] = len(results['errors']) == 0
        logger.info(
            f"CSV import completed: {results['imported']} imported, "
            f"{results['updated']} updated, {results['skipped']} skipped, "
            f"{len(results['errors'])} errors"
        )
        
    except Exception as e:
        results['errors'].append(f"Fatal error: {str(e)}")
        logger.error(f"CSV import failed: {e}")
    
    return results


def export_services_to_csv(csv_file_path: str, active_only: bool = False) -> bool:
    """
    Export all services to CSV file.
    
    Args:
        csv_file_path: Output file path
        active_only: If True, only exports active services
    
    Returns:
        True if successful, False otherwise
    """
    try:
        with db_session() as db:
            query = db.query(Service)
            if active_only:
                query = query.filter(Service.active == True)
            
            services = query.order_by(Service.category, Service.name, Service.variant).all()
            
            with open(csv_file_path, 'w', newline='', encoding='utf-8') as f:
                writer = csv.writer(f)
                
                # Write header
                writer.writerow([
                    'category', 'service_name', 'variant', 'display_name', 'price', 'notes'
                ])
                
                # Write data
                for service in services:
                    writer.writerow([
                        service.category or '',
                        service.name,
                        service.variant or '',
                        service.display_name or service.name,
                        str(service.price) if service.price else '',
                        service.notes or ''
                    ])
            
            logger.info(f"Exported {len(services)} services to {csv_file_path}")
            return True
    
    except Exception as e:
        logger.error(f"Export failed: {e}")
        return False
