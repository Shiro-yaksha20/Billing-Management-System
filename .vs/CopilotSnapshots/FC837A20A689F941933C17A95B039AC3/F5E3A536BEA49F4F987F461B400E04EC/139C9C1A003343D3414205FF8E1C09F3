review_link = settings_service.get_setting("google_review_link", "")
if review_link:
    story.append(Paragraph("Scan the QR code to leave a review!", footer_style))
    story.append(Spacer(1, 6))
    
    try:
        # Generate QR code
        qr = QrCodeWidget(review_link)
        qr_bounds = qr.getBounds()
        qr_width = qr_bounds[2] - qr_bounds[0]
        qr_height = qr_bounds[3] - qr_bounds[1]
        
        # Create drawing with QR code centered
        qr_drawing = Drawing(100, 100, transform=[100./qr_width, 0, 0, 100./qr_height, 0, 0])
        qr_drawing.add(qr)
        qr_drawing.hAlign = 'CENTER'
        
        story.append(qr_drawing)
    except Exception as e:
        logger.warning(f"Could not generate QR code: {e}")
        story.append(Paragraph(f"<font size=8>{review_link}</font>", footer_style))

# Final separator
story.append(Spacer(1, 12))
story.append(HRFlowable(width="100%", thickness=1, color=HexColor('#000000')))
```

Why: Professional footer with review mechanism for customer feedback.

